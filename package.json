{
  "name": "black-crystal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Black Crystal Consulting — environmental, social and cultural heritage advisory website (Astro, static-first).",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:review": "BC_SHOW_DRAFTS=true astro build && node scripts/postbuild.mjs",
    "start": "node --env-file-if-exists=.env server/serve.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "links": "node scripts/check-links.mjs",
    "qa": "npm run check && npm run lint && npm run test && npm run build:review && npm run links && npm run test:e2e",
    "video:build": "bash scripts/build-hero-video.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "compression": "^1.8.2",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}

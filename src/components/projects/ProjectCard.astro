---
import Icon from '../ui/Icon.astro';
import { formatPeriod, periodBucket, type Project } from '../../lib/content';
import type { ServiceCategoryId } from '../../data/site';

interface Props {
  project: Project;
  categories: ServiceCategoryId[];
  sectorLabels: Record<string, string>;
  headingLevel?: 'h2' | 'h3';
}
const { project, categories, sectorLabels, headingLevel = 'h3' } = Astro.props;
const p = project.data;
const Heading = headingLevel;
const searchText = [
  p.title,
  p.description,
  p.client,
  p.location,
  p.country,
  p.deliverable,
  ...p.partners,
  ...p.standards,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<li
  class="project-card card-link"
  data-project
  data-sectors={p.sectors.length ? p.sectors.join(' ') : 'cross-sector'}
  data-categories={categories.join(' ')}
  data-services={p.services.map((s) => s.id).join(' ')}
  data-period={periodBucket(p)}
  data-search={searchText}
>
  <div class="project-card__top">
    <span class="project-card__period">{formatPeriod(p)}</span>
    <span class="project-card__type">{p.deliverable}</span>
  </div>
  <Heading class="project-card__title">
    <a class="stretched" href={`/projects/${project.id}/`}>
      {p.title}
    </a>
  </Heading>
  <p class="project-card__meta">
    {p.client && <span>{p.client}</span>}
    {p.location && <span>{p.location}</span>}
    {!p.client && !p.location && p.country && <span>{p.country}</span>}
  </p>
  <ul class="project-card__tags" role="list" aria-label="Sectors">
    {p.sectors.length ? (
      p.sectors.map((s) => <li class="tag">{sectorLabels[s]}</li>)
    ) : (
      <li class="tag tag--muted">Cross-sector</li>
    )}
    {p.standards.some((s) => s.includes('IFC')) && <li class="tag tag--gold">IFC</li>}
  </ul>
  <span class="project-card__arrow" aria-hidden="true">
    <Icon name="arrow-right" size={18} />
  </span>
</li>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    transition:
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }
  .project-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-raised);
  }
  .project-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding-right: 26px;
  }
  .project-card__period {
    color: var(--bc-thunder);
    font-size: 0.875rem;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }
  .project-card__type {
    color: var(--color-gold-readable);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .project-card__title {
    font-size: 1.0625rem;
    font-weight: 750;
    line-height: 1.38;
    letter-spacing: -0.005em;
  }
  .project-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .project-card:hover .project-card__title a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .project-card__meta {
    display: grid;
    gap: 2px;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 4px;
  }
  .tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: #eef2ea;
    color: var(--color-green-readable);
    font-size: 0.75rem;
    font-weight: 750;
  }
  .tag--muted {
    background: var(--color-surface-warm);
    color: var(--color-muted);
  }
  .tag--gold {
    background: #fbf1da;
    color: #6b4b0f;
  }
  .project-card__arrow {
    position: absolute;
    top: 20px;
    right: 18px;
    color: var(--color-gold-readable);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .project-card:hover .project-card__arrow {
    transform: translate(2px, -2px) rotate(-45deg);
  }
</style>

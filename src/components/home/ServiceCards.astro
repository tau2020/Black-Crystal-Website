---
import Icon from '../ui/Icon.astro';
import MediaImage from '../ui/MediaImage.astro';
import { serviceCategories } from '../../data/site';
---

<section class="svc section" aria-labelledby="svc-title">
  <div class="container container--wide">
    <div class="section-head" data-reveal>
      <div class="section-head__text">
        <p class="eyebrow">Our services</p>
        <h2 id="svc-title">Explore our expertise.</h2>
        <p>Explore specialist assessments, advisory and training services.</p>
      </div>
      <a href="/services/" class="link-arrow">
        View All Services <Icon name="arrow-right" />
      </a>
    </div>
    <ul class="svc-grid" role="list">
      {serviceCategories.map((c, i) => (
        <li class="svc-card card-link" data-reveal data-reveal-step={String(i)}>
          <div class="svc-card__media media-zoom">
            <MediaImage
              name={c.image}
              widths={[360, 520, 720]}
              sizes="(min-width: 1100px) 22vw, (min-width: 600px) 45vw, 100vw"
              alt=""
            />
          </div>
          <div class="svc-card__body">
            <Icon name={c.icon} size={28} strokeWidth={1.5} class="svc-card__icon" />
            <div>
              <h3>
                <a class="stretched" href={`/services/#${c.id}`}>
                  {c.title}
                </a>
              </h3>
              <p>{c.summary}</p>
            </div>
            <span class="svc-card__arrow" aria-hidden="true">
              <Icon name="arrow-right" size={18} />
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 22px);
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    transition:
      box-shadow var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }
  .svc-card:hover {
    box-shadow: var(--shadow-raised);
  }
  .svc-card__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 7.5;
    object-fit: cover;
  }
  .svc-card__body {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    flex: 1;
    padding: 20px 20px 52px;
  }
  :global(.svc-card__icon) {
    color: var(--bc-green);
  }
  .svc-card h3 {
    margin-bottom: 8px;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .svc-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .svc-card:hover h3 a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .svc-card p {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .svc-card__arrow {
    position: absolute;
    left: 20px;
    bottom: 18px;
    color: var(--color-gold-readable);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .svc-card:hover .svc-card__arrow {
    transform: translateX(4px);
  }
  @media (max-width: 1099.98px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599.98px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Icon from '../ui/Icon.astro';
import MediaImage from '../ui/MediaImage.astro';

// Verified service lines (Company Profile 2024, p.5; flyer 2024), each linked to its discipline page.
const items = [
  {
    label: 'Environmental & Social Impact Assessments',
    href: '/services/environmental-social-impact-assessment/',
  },
  { label: 'Environmental Auditing', href: '/services/environmental-social-auditing/' },
  { label: 'Ecological Surveys & Monitoring', href: '/services/biodiversity-ecological-surveys/' },
  { label: 'Social Risk Assessments', href: '/services/social-risk-assessment/' },
  {
    label: 'Archaeological & Cultural Heritage Assessments',
    href: '/services/archaeological-cultural-heritage/',
  },
  { label: 'GIS Mapping', href: '/services/gis-mapping/' },
  { label: 'Legal Compliance', href: '/services/legal-compliance/' },
  { label: 'Mine Closure Planning', href: '/services/mine-closure-planning/' },
  { label: 'Sustainability Advisory', href: '/services/sustainability-advisory/' },
  { label: 'Environmental Training', href: '/services/environmental-training-education/' },
];
---

<section class="specialist on-dark" aria-labelledby="specialist-title">
  <div class="specialist__media">
    <MediaImage
      name="banner-fieldwork"
      widths={[420, 600, 750]}
      sizes="(min-width: 900px) 36vw, 100vw"
      class="specialist__img"
    />
  </div>
  <div class="specialist__panel">
    <svg
      class="specialist__topo"
      viewBox="0 0 1200 600"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <g stroke="currentColor" stroke-width="1.4">
        <path d="M 50 510 Q 420 -40 790 200 T 1240 250" />
        <path d="M 20 495 Q 430 -13 783 211 T 1237 263" />
        <path d="M -10 480 Q 440 14 776 222 T 1234 276" />
        <path d="M -40 465 Q 450 41 769 233 T 1231 289" />
        <path d="M -70 450 Q 460 68 762 244 T 1228 302" />
        <path d="M -100 435 Q 470 95 755 255 T 1225 315" />
        <path d="M -130 420 Q 480 122 748 266 T 1222 328" />
        <path d="M -160 405 Q 490 149 741 277 T 1219 341" />
      </g>
    </svg>
    <div class="specialist__content" data-reveal>
      <p class="eyebrow">Specialist services</p>
      <h2 id="specialist-title">From insight to impact.</h2>
      <p class="specialist__lead">
        Expert environmental and social advisory, from project assessment to sustainable implementation.
      </p>
      <ul class="specialist__list" role="list">
        {items.map((item) => (
          <li>
            <a href={item.href}>
              <Icon name="check-circle" size={22} strokeWidth={1.6} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/services/" class="link-arrow specialist__all">
        View All Services <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .specialist {
    display: grid;
    grid-template-columns: minmax(0, 36fr) minmax(0, 64fr);
    background: var(--color-panel);
  }
  .specialist__media {
    position: relative;
    min-height: 100%;
    border-right: 6px solid var(--bc-gold);
  }
  .specialist__media :global(picture),
  .specialist__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 22%;
  }
  .specialist__panel {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #2f4a36 0%, var(--color-panel) 45%, var(--color-panel-deep) 100%);
  }
  .specialist__topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #c6962c;
    opacity: 0.1;
  }
  .specialist__content {
    position: relative;
    max-width: 860px;
    padding: clamp(48px, 6.5vw, 96px) clamp(24px, 5.5vw, 88px);
  }
  .specialist__content h2 {
    font-size: clamp(2.2rem, 3.6vw, 3.4rem);
    letter-spacing: -0.025em;
  }
  .specialist__lead {
    max-width: 48ch;
    margin-top: 16px;
    color: var(--color-on-dark-muted);
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.6;
  }
  .specialist__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 36px;
    margin-top: clamp(28px, 3.5vw, 44px);
  }
  .specialist__list a {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-height: 48px;
    padding-block: 10px;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    color: #fff;
    font-size: 1.0125rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }
  .specialist__list a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .specialist__list :global(svg) {
    flex: none;
    margin-top: -1px;
    color: var(--bc-gold);
  }
  .specialist__all {
    margin-top: 26px;
  }

  @media (max-width: 899.98px) {
    .specialist {
      grid-template-columns: 1fr;
    }
    .specialist__media {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: 6px solid var(--bc-gold);
    }
    .specialist__media :global(img) {
      object-position: 40% 20%;
    }
  }
  @media (max-width: 599.98px) {
    .specialist__list {
      grid-template-columns: 1fr;
    }
    .specialist__media {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>

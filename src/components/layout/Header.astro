---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import MediaImage from '../ui/MediaImage.astro';
import MobileNav from './MobileNav.astro';
import SearchDialog from './SearchDialog.astro';
import logo from '../../assets/images/brand/logo.png';
import { aboutLinks, primaryNav, sectorIds } from '../../data/site';
import { getFeaturedProjects, getSectors, getServicesByCategory } from '../../lib/content';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href);
const inSection = (href: string) => href !== '/' && path.startsWith(href);

const groups = await getServicesByCategory();
const sectors = await getSectors();
const featured = (await getFeaturedProjects('carousel')).slice(0, 2);
const sectorLabels: Record<(typeof sectorIds)[number], string> = {
  mining: 'Mining',
  energy: 'Energy',
  infrastructure: 'Infrastructure',
  housing: 'Housing',
  tourism: 'Tourism',
};
---

<header class="site-header" data-site-header>
  <div class="site-header__bar container container--wide">
    <a href="/" class="brand" aria-label="Black Crystal Consulting — home">
      <Image
        src={logo}
        alt="Black Crystal — caring for the environment beyond today"
        width={172}
        densities={[1, 2]}
        format="webp"
        loading="eager"
        class="brand__logo"
      />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul class="primary-nav__list" role="list">
        {primaryNav.map((item) => (
          <li class="primary-nav__item" data-nav-item={'menu' in item ? item.menu : undefined}>
            <a
              href={item.href}
              class:list={[
                'primary-nav__link',
                { 'is-active': isCurrent(item.href) || inSection(item.href) },
              ]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            {'menu' in item && (
              <button
                type="button"
                class="primary-nav__toggle"
                aria-expanded="false"
                aria-controls={`mega-${item.menu}`}
                data-mega-toggle={item.menu}
                hidden
              >
                <span class="visually-hidden">{item.label} menu</span>
                <Icon name="chevron-down" size={16} strokeWidth={2} />
              </button>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="icon-button" data-search-open aria-haspopup="dialog" hidden>
        <Icon name="search" size={21} />
        <span class="visually-hidden">Search the site</span>
      </button>
      <a
        href="/contact/"
        class:list={['btn btn--primary btn--sm header-cta', { 'is-current': path.startsWith('/contact') }]}
        aria-current={path === '/contact/' ? 'page' : undefined}
      >
        Contact Us <Icon name="arrow-right" />
      </a>
      <a href="#footer-nav" class="icon-button menu-toggle" data-mobile-open>
        <Icon name="menu" size={24} />
        <span class="visually-hidden">Menu</span>
      </a>
    </div>
  </div>

  <!-- About -->
  <div class="mega" id="mega-about" data-mega-panel="about" hidden>
    <div class="mega__inner container container--wide mega__inner--about">
      <div class="mega__intro">
        <p class="eyebrow">About Black Crystal</p>
        <p class="mega__lead">
          Environmental, socio-economic and cultural heritage advisory, established in Harare in 2005.
        </p>
        <a href="/about/" class="link-arrow">
          About us overview <Icon name="arrow-right" />
        </a>
      </div>
      <ul class="mega__links mega__links--two-col" role="list">
        {aboutLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a href="/about/#story" class="mega-feature card-link">
        <span class="mega-feature__media media-zoom">
          <MediaImage name="banner-zebras" widths={[400, 640]} sizes="320px" alt="" />
        </span>
        <span class="mega-feature__text">
          <span class="mega-feature__title">People. Expertise. A sustainable future.</span>
          <span class="mega-feature__cta">
            Read our story <Icon name="arrow-right" size={16} />
          </span>
        </span>
      </a>
    </div>
  </div>

  <!-- Services -->
  <div class="mega" id="mega-services" data-mega-panel="services" hidden>
    <div class="mega__inner container container--wide">
      <div class="mega__grid mega__grid--services">
        {groups.map(({ category, services }) => (
          <div class="mega__col">
            <a href={`/services/#${category.id}`} class="mega__heading">
              <Icon name={category.icon} size={20} />
              {category.title}
            </a>
            <ul class="mega__links" role="list">
              {services.map((s) => (
                <li>
                  <a href={`/services/${s.id}/`}>{s.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mega__footer">
        <a href="/services/" class="link-arrow">
          All services <Icon name="arrow-right" />
        </a>
        <a href="/contact/" class="link-arrow">
          Discuss your project <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>

  <!-- Sectors -->
  <div class="mega" id="mega-sectors" data-mega-panel="sectors" hidden>
    <div class="mega__inner container container--wide">
      <ul class="mega-sectors" role="list">
        {sectors.map((s) => (
          <li>
            <a href={`/sectors/${s.id}/`} class="mega-sector">
              <span class="mega-sector__media media-zoom">
                <MediaImage name={s.data.cardImage} widths={[240, 360]} sizes="200px" alt="" />
              </span>
              <span class="mega-sector__label">
                <Icon name={s.data.icon} size={18} />
                {s.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mega__footer">
        <a href="/sectors/" class="link-arrow">
          Explore all sectors <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>

  <!-- Projects -->
  <div class="mega" id="mega-projects" data-mega-panel="projects" hidden>
    <div class="mega__inner container container--wide mega__inner--projects">
      <div class="mega__col">
        <p class="mega__heading mega__heading--plain">Project portfolio</p>
        <ul class="mega__links" role="list">
          <li>
            <a href="/projects/">All documented projects</a>
          </li>
          <li>
            <a href="/#featured-projects">Featured projects</a>
          </li>
          <li>
            <a href="/projects/#portfolio-overview">Portfolio at a glance</a>
          </li>
        </ul>
      </div>
      <div class="mega__col">
        <p class="mega__heading mega__heading--plain">Filter by sector</p>
        <ul class="mega__links mega__links--two-col" role="list">
          {sectorIds.map((id) => (
            <li>
              <a href={`/projects/?sector=${id}`}>{sectorLabels[id]}</a>
            </li>
          ))}
        </ul>
      </div>
      <ul class="mega-projects" role="list">
        {featured.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`} class="mega-project">
              <span class="mega-project__media media-zoom">
                <MediaImage name={p.data.image} widths={[240, 400]} sizes="160px" alt="" />
              </span>
              <span>
                <span class="mega-project__meta">{p.data.deliverable}</span>
                <span class="mega-project__title">{p.data.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>
<div class="mega-backdrop" data-mega-backdrop hidden></div>

<MobileNav groups={groups} sectors={sectors} />
<SearchDialog />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow var(--duration-base) var(--ease-standard);
  }
  .site-header.is-scrolled {
    box-shadow: 0 8px 24px rgb(35 31 32 / 7%);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    flex: none;
    border-radius: 4px;
  }
  .brand__logo {
    width: 172px;
    height: auto;
  }

  .primary-nav {
    margin-inline: auto;
  }
  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0px, 0.6vw, 8px);
  }
  .primary-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .primary-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--header-h);
    padding-inline: clamp(9px, 1vw, 14px);
    color: var(--bc-thunder);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .primary-nav__item:has(.primary-nav__toggle:not([hidden])) .primary-nav__link {
    padding-right: 4px;
  }
  .primary-nav__link::after {
    content: '';
    position: absolute;
    left: clamp(9px, 1vw, 14px);
    right: clamp(9px, 1vw, 14px);
    bottom: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--bc-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .primary-nav__link:hover::after,
  .primary-nav__item.is-open .primary-nav__link::after {
    transform: scaleX(0.55);
    opacity: 0.6;
  }
  .primary-nav__link.is-active::after {
    transform: scaleX(1);
    opacity: 1;
  }
  .primary-nav__toggle {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 36px;
    margin-right: 2px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-muted);
  }
  .primary-nav__toggle:hover {
    color: var(--bc-thunder);
    background: var(--color-surface-warm);
  }
  .primary-nav__toggle svg {
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .primary-nav__toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .icon-button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--bc-thunder);
  }
  .icon-button:hover {
    background: var(--color-surface-warm);
  }
  .header-cta.is-current {
    box-shadow: inset 0 -3px 0 rgb(35 31 32 / 35%);
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 1099.98px) {
    .primary-nav__link {
      font-size: 0.9rem;
    }
    .brand__logo {
      width: 150px;
    }
  }
  @media (max-width: 1023.98px) {
    .primary-nav,
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: inline-grid;
    }
    .site-header__actions {
      margin-left: auto;
      gap: 4px;
    }
    .brand__logo {
      width: 140px;
    }
  }

  /* ── Mega panels ─────────────────────────────────────────── */
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-menu);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 200ms var(--ease-standard),
      transform 240ms var(--ease-out);
  }
  .mega.is-open {
    opacity: 1;
    transform: none;
  }
  .mega__inner {
    padding-block: 34px 30px;
  }
  .mega__grid--services {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 28px 36px;
  }
  .mega__col {
    min-width: 0;
  }
  .mega__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
    color: var(--bc-thunder);
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
  }
  .mega__heading svg {
    color: var(--bc-green);
  }
  a.mega__heading:hover {
    color: var(--color-gold-readable);
  }
  .mega__heading--plain {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-readable);
  }
  .mega__links {
    display: grid;
    gap: 2px;
  }
  .mega__links--two-col {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
  }
  .mega__links a {
    display: block;
    padding: 7px 0;
    color: var(--color-body);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .mega__links a:hover {
    color: var(--color-gold-readable);
    text-decoration: underline;
  }
  .mega__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }

  .mega__inner--about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .mega__lead {
    margin-bottom: 8px;
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.45;
  }
  .mega-feature {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }
  .mega-feature > * {
    grid-area: 1 / 1;
  }
  .mega-feature__media :global(img) {
    width: 100%;
    height: 170px;
    object-fit: cover;
  }
  .mega-feature__text {
    z-index: 1;
    align-self: end;
    display: grid;
    gap: 4px;
    padding: 18px;
    background: linear-gradient(180deg, transparent, rgb(20 17 14 / 82%));
  }
  .mega-feature__title {
    font-weight: 800;
    line-height: 1.3;
  }
  .mega-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-gold-on-dark);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .mega-sectors {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }
  .mega-sector {
    display: grid;
    gap: 10px;
    color: var(--bc-thunder);
    text-decoration: none;
  }
  .mega-sector__media {
    border-radius: var(--radius-md);
  }
  .mega-sector__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .mega-sector__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 750;
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .mega-sector__label :global(svg) {
    flex: none;
    color: var(--bc-green);
  }
  .mega-sector:hover .mega-sector__label {
    color: var(--color-gold-readable);
  }

  .mega__inner--projects {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 40px;
  }
  .mega-projects {
    display: grid;
    gap: 14px;
  }
  .mega-project {
    display: grid;
    grid-template-columns: 136px 1fr;
    gap: 16px;
    align-items: center;
    color: var(--bc-thunder);
    text-decoration: none;
  }
  .mega-project__media {
    border-radius: var(--radius-md);
  }
  .mega-project__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .mega-project__meta {
    display: block;
    margin-bottom: 4px;
    color: var(--color-gold-readable);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mega-project__title {
    display: block;
    font-weight: 700;
    line-height: 1.35;
  }
  .mega-project:hover .mega-project__title {
    text-decoration: underline;
  }

  .mega-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgb(29 25 22 / 28%);
    opacity: 0;
    transition: opacity 220ms var(--ease-standard);
  }
  .mega-backdrop.is-open {
    opacity: 1;
  }
  @media (max-width: 1023.98px) {
    .mega,
    .mega-backdrop {
      display: none !important;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import MediaImage from '../ui/MediaImage.astro';
import logoInverted from '../../assets/images/brand/logo-inverted.png';
import { company, contact, serviceCategories } from '../../data/site';
import { getSectors } from '../../lib/content';

const sectors = await getSectors();
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <section class="footer-sectors" aria-labelledby="footer-sectors-title">
    <div class="footer-sectors__media" aria-hidden="true">
      <MediaImage name="banner-footer-valley" widths={[960, 1440, 1920]} sizes="100vw" alt="" />
    </div>
    <div class="footer-sectors__inner container container--wide">
      <div class="footer-sectors__intro">
        <h2 id="footer-sectors-title">Key Sectors</h2>
        <p>
          We work across a range of sectors to support responsible development and environmental stewardship.
        </p>
      </div>
      <ul class="footer-sectors__list" role="list">
        {sectors.map((s) => (
          <li>
            <a href={`/sectors/${s.id}/`}>
              <Icon name={s.data.icon} size={26} />
              <span>{s.data.shortTitle}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/sectors/" class="btn btn--primary btn--sm footer-sectors__cta">
        Explore All Sectors <Icon name="arrow-right" />
      </a>
    </div>
  </section>

  <div class="footer-main">
    <div class="footer-main__grid container container--wide">
      <div class="footer-brand">
        <a href="/" class="footer-brand__logo" aria-label="Black Crystal Consulting — home">
          <Image src={logoInverted} alt="" width={200} densities={[1, 2]} format="webp" loading="lazy" />
        </a>
        <p>
          Environmental, social and cultural heritage advisory for responsible development in Zimbabwe, South
          Africa and the wider region — since {company.founded}.
        </p>
        <a href="/contact/" class="btn btn--primary btn--sm">
          Discuss your project <Icon name="arrow-right" />
        </a>
      </div>

      <nav class="footer-col" id="footer-nav" aria-label="Footer">
        <h2 class="footer-col__title">Company</h2>
        <ul role="list">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/about/">About us</a>
          </li>
          <li>
            <a href="/projects/">Projects</a>
          </li>
          <li>
            <a href="/insights/">Insights</a>
          </li>
          <li>
            <a href="/contact/">Contact</a>
          </li>
          <li>
            <a href="/privacy/">Privacy notice</a>
          </li>
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-col__title">Services</h2>
        <ul role="list">
          {serviceCategories.map((c) => (
            <li>
              <a href={`/services/#${c.id}`}>{c.title}</a>
            </li>
          ))}
          <li>
            <a href="/services/">All services</a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-col__title">Sectors</h2>
        <ul role="list">
          {sectors.map((s) => (
            <li>
              <a href={`/sectors/${s.id}/`}>{s.data.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-contact">
        <h2 class="footer-col__title">Contact</h2>
        {contact.offices.map((o) => (
          <address>
            <strong>{o.country}</strong>
            {o.lines.map((l) => (
              <span>{l}</span>
            ))}
          </address>
        ))}
        <ul role="list" class="footer-contact__lines">
          {contact.phones.map((p) => (
            <li>
              <a href={p.href}>
                <Icon name="phone" size={16} />
                {p.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${contact.email}`}>
              <Icon name="mail" size={16} />
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom container container--wide">
      <p>
        &copy; {year}
        {company.name}. Registered in Zimbabwe (Company Registration No. {company.registrationNumber}) and in
        South Africa ({company.southAfricaRegistered}).
      </p>
      <p class="footer-bottom__links">
        <a href="/privacy/">Privacy notice</a>
        <a href="#main" class="footer-top">
          Back to top <Icon name="arrow-up" size={16} />
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-night);
    color: var(--color-on-dark);
  }
  .footer-sectors {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .footer-sectors__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .footer-sectors__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .footer-sectors__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(20 17 14 / 78%) 0%, rgb(20 17 14 / 36%) 50%, rgb(20 17 14 / 55%) 100%),
      linear-gradient(180deg, rgb(20 17 14 / 0%) 35%, var(--color-night) 100%);
  }
  .footer-sectors__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 2.3fr) auto;
    align-items: center;
    gap: 28px 40px;
    padding-block: clamp(40px, 5vw, 64px);
  }
  .footer-sectors__intro h2 {
    margin-bottom: 8px;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
  }
  .footer-sectors__intro p {
    max-width: 44ch;
    color: var(--color-on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .footer-sectors__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .footer-sectors__list a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-standard);
  }
  .footer-sectors__list a:hover {
    background: rgb(255 255 255 / 10%);
  }
  .footer-sectors__list :global(svg) {
    flex: none;
    color: var(--color-gold-on-dark);
  }

  .footer-main {
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid rgb(255 255 255 / 8%);
  }
  .footer-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 0.8fr)) minmax(0, 1.3fr);
    gap: 40px 32px;
  }
  .footer-brand p {
    margin: 18px 0 22px;
    max-width: 38ch;
    color: var(--color-on-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .footer-brand__logo {
    display: inline-flex;
  }
  .footer-brand__logo :global(img) {
    width: 200px;
    height: auto;
  }
  .footer-col__title {
    margin-bottom: 14px;
    color: var(--color-gold-on-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .footer-col ul {
    display: grid;
    gap: 2px;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    color: var(--color-on-dark);
    font-size: 0.9375rem;
    text-decoration: none;
    word-break: break-word;
  }
  .footer-col a:hover {
    color: var(--color-gold-on-dark);
    text-decoration: underline;
  }
  .footer-contact address {
    display: grid;
    margin-bottom: 14px;
    color: var(--color-on-dark-muted);
    font-size: 0.9375rem;
    font-style: normal;
    line-height: 1.55;
  }
  .footer-contact address strong {
    color: #fff;
    font-weight: 750;
  }
  .footer-contact__lines :global(svg) {
    color: var(--color-gold-on-dark);
    flex: none;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(36px, 4vw, 56px);
    padding-block: 22px 28px;
    border-top: 1px solid rgb(255 255 255 / 10%);
    color: #b9b2a6;
    font-size: 0.8125rem;
  }
  .footer-bottom__links {
    display: flex;
    gap: 24px;
  }
  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: #e6dfd2;
  }
  .footer-bottom a:hover {
    color: var(--color-gold-on-dark);
  }

  @media (max-width: 1199.98px) {
    .footer-sectors__inner {
      grid-template-columns: 1fr auto;
    }
    .footer-sectors__list {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .footer-main__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767.98px) {
    .footer-sectors__inner {
      grid-template-columns: 1fr;
    }
    .footer-sectors__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-row: auto;
    }
    .footer-sectors__cta {
      justify-self: start;
    }
    .footer-main__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-contact {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 399.98px) {
    .footer-main__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Icon from '../ui/Icon.astro';

const suggestions = [
  'ESIA',
  'Mining',
  'Renewable energy',
  'Cultural heritage',
  'Unki',
  'IFC standards',
  'Victoria Falls',
];
---

<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
  <div class="search-dialog__panel">
    <div class="search-dialog__head">
      <h2 id="search-dialog-title" class="search-dialog__title">
        Search Black Crystal
      </h2>
      <button type="button" class="search-dialog__close" data-search-close>
        <Icon name="close" size={22} />
        <span class="visually-hidden">Close search</span>
      </button>
    </div>
    <form role="search" class="search-form" data-search-form action="/projects/" method="get">
      <label for="site-search" class="visually-hidden">
        Search services, sectors, projects and insights
      </label>
      <Icon name="search" size={22} class="search-form__icon" />
      <input
        id="site-search"
        type="search"
        name="q"
        class="search-form__input"
        placeholder="Search services, sectors, projects…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
      />
    </form>
    <p class="search-status" id="search-status" role="status" aria-live="polite" data-search-status></p>
    <ul class="search-results" role="list" data-search-results aria-labelledby="search-dialog-title"></ul>
    <div class="search-suggest" data-search-suggest>
      <p class="search-suggest__label">Try</p>
      <ul class="search-suggest__list" role="list">
        {suggestions.map((s) => (
          <li>
            <button type="button" class="chip" data-search-suggestion={s}>
              {s}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(100% - 32px, 760px);
    max-height: min(84dvh, 720px);
    margin: clamp(16px, 9vh, 96px) auto auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--bc-thunder);
    box-shadow: var(--shadow-raised);
  }
  .search-dialog::backdrop {
    background: rgb(29 25 22 / 55%);
  }
  .search-dialog[open] {
    display: flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    .search-dialog,
    .search-dialog::backdrop {
      transition:
        opacity 180ms var(--ease-standard),
        transform 220ms var(--ease-out),
        overlay 220ms allow-discrete,
        display 220ms allow-discrete;
      opacity: 0;
    }
    .search-dialog {
      transform: translateY(-10px);
    }
    .search-dialog[open],
    .search-dialog[open]::backdrop {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .search-dialog[open],
      .search-dialog[open]::backdrop {
        opacity: 0;
      }
      .search-dialog[open] {
        transform: translateY(-10px);
      }
    }
  }
  .search-dialog__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 20px clamp(16px, 3vw, 28px) 24px;
    overflow: hidden;
  }
  .search-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .search-dialog__title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
  }
  .search-dialog__close {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
  }
  .search-dialog__close:hover {
    background: var(--color-surface-warm);
  }
  .search-form {
    position: relative;
  }
  .search-form :global(.search-form__icon) {
    position: absolute;
    left: 16px;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-muted);
    pointer-events: none;
  }
  .search-form__input {
    width: 100%;
    min-height: 56px;
    padding: 12px 16px 12px 50px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-warm);
    font-size: 1.0625rem;
  }
  .search-form__input:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
    background: #fff;
  }
  .search-status {
    margin: 14px 2px 6px;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .search-status:empty {
    display: none;
  }
  .search-results {
    overflow-y: auto;
    margin: 0 -8px;
    padding: 0 8px 4px;
  }
  .search-results :global(a) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding: 12px 12px;
    border-radius: var(--radius-md);
    color: var(--bc-thunder);
    text-decoration: none;
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    background: var(--color-surface-warm);
  }
  .search-results :global(.sr-kind) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--color-gold-readable);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .search-results :global(.sr-title) {
    font-weight: 750;
    line-height: 1.35;
  }
  .search-results :global(.sr-desc) {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results :global(mark) {
    background: #fbefcf;
    color: inherit;
    border-radius: 2px;
  }
  .search-suggest {
    margin-top: 16px;
  }
  .search-suggest__label {
    margin-bottom: 8px;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .search-suggest__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .search-suggest__list .chip {
    min-height: 36px;
    cursor: pointer;
  }
  .search-suggest__list .chip:hover {
    border-color: var(--bc-gold);
  }
</style>

---
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import MediaImage from '../../components/ui/MediaImage.astro';
import {
  formatDate,
  formatPeriod,
  getInsights,
  insightCategoryLabels,
  type Insight,
} from '../../lib/content';
import { company } from '../../data/site';
import { breadcrumbJsonLd } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const insights = await getInsights();
  return insights.map((insight) => ({ params: { slug: insight.id }, props: { insight } }));
}) satisfies GetStaticPaths;

interface Props {
  insight: Insight;
}
const { insight } = Astro.props;
const { Content } = await render(insight);
const d = insight.data;
const isDraft = d.status === 'draft';
const services = await getEntries(d.relatedServices);
const projects = await getEntries(d.relatedProjects);
const site = Astro.site ?? new URL('https://blackcrystal.co.zw');
const path = `/insights/${insight.id}/`;

const articleLd =
  !isDraft && d.publishedDate && d.author
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: d.title,
        description: d.summary,
        datePublished: d.publishedDate.toISOString(),
        author: { '@type': 'Person', name: d.author },
        publisher: { '@id': new URL('/#organization', site).href },
        mainEntityOfPage: new URL(path, site).href,
      }
    : null;
---

<BaseLayout
  title={d.title}
  description={d.seoDescription}
  type="article"
  noindex={isDraft}
  jsonLd={[
    breadcrumbJsonLd(site, [
      { name: 'Home', href: '/' },
      { name: 'Insights', href: '/insights/' },
      { name: d.title, href: path },
    ]),
    ...(articleLd ? [articleLd] : []),
  ]}
>
  <article class="article">
    <header class="article__header container container--narrow">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/insights/">Insights</a>
          </li>
          <li>
            <span aria-current="page">{insightCategoryLabels[d.category]}</span>
          </li>
        </ol>
      </nav>
      {isDraft && (
        <div class="draft-banner" role="note">
          <Icon name="info" size={20} />
          <p>
            <strong>Draft for Black Crystal review.</strong> This article has not been approved for
            publication and is excluded from production builds.
          </p>
        </div>
      )}
      <p class="eyebrow">{insightCategoryLabels[d.category]}</p>
      <h1>{d.title}</h1>
      <p class="article__summary">{d.summary}</p>
      <p class="article__meta">
        {!isDraft && d.publishedDate && (
          <time datetime={d.publishedDate.toISOString()}>{formatDate(d.publishedDate)}</time>
        )}
        {!isDraft && d.author && <span>{d.author}</span>}
        <span>{company.name}</span>
        {d.readingMinutes && <span>{d.readingMinutes} min read</span>}
      </p>
    </header>

    <figure class="article__figure container container--wide">
      <div class="article__image">
        <MediaImage
          name={d.image}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1360px) 1360px, 100vw"
          loading="eager"
        />
      </div>
      <figcaption>Illustrative image.</figcaption>
    </figure>

    <div class="article__body container container--narrow">
      <div class="prose">
        <Content />
      </div>

      <section class="sources" aria-labelledby="sources-title">
        <h2 id="sources-title">Sources</h2>
        <ul role="list">
          {d.sources.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  {(services.length > 0 || projects.length > 0) && (
    <section class="section section--warm" aria-labelledby="related-title">
      <div class="related container container--wide">
        <h2 id="related-title" class="visually-hidden">
          Related services and projects
        </h2>
        {services.length > 0 && (
          <div>
            <p class="eyebrow">Related services</p>
            <ul role="list" class="related__list">
              {services.map((s) => (
                <li>
                  <a href={`/services/${s.id}/`}>
                    <Icon name={s.data.icon} size={20} />
                    <span>{s.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {projects.length > 0 && (
          <div>
            <p class="eyebrow">Related projects</p>
            <ul role="list" class="related__list">
              {projects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>
                    <Icon name="file-search" size={20} />
                    <span>
                      {p.data.title} <span class="related__year">({formatPeriod(p.data)})</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .article__header {
    padding-block: clamp(32px, 5vw, 64px) 32px;
  }
  .article__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 24px;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .article__crumbs li + li::before {
    content: '/';
    margin-inline: 10px;
    opacity: 0.6;
  }
  .article__crumbs a {
    color: var(--bc-thunder);
  }
  .draft-banner {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    padding: 14px 16px;
    border: 1px solid #ecd39c;
    border-radius: var(--radius-md);
    background: #fffaf0;
    font-size: 0.9375rem;
  }
  .draft-banner :global(svg) {
    flex: none;
    color: #8a6416;
  }
  .article h1 {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
  }
  .article__summary {
    margin-top: 16px;
    color: var(--color-muted);
    font-size: clamp(1.075rem, 1.4vw, 1.25rem);
    line-height: 1.6;
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 18px;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .article__figure figcaption {
    margin-top: 8px;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  .article__image {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .article__image :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }
  .article__body {
    padding-block: clamp(32px, 5vw, 56px) clamp(48px, 6vw, 80px);
  }
  .sources {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .sources h2 {
    margin-bottom: 10px;
    font-size: 1rem;
  }
  .sources ul {
    display: grid;
    gap: 6px;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .related__list {
    display: grid;
    gap: 8px;
  }
  .related__list a {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--bc-thunder);
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }
  .related__list a:hover {
    border-color: var(--bc-gold);
  }
  .related__list :global(svg) {
    flex: none;
    color: var(--bc-green);
  }
  .related__year {
    color: var(--color-muted);
    font-weight: 600;
  }
  @media (max-width: 799.98px) {
    .related {
      grid-template-columns: 1fr;
    }
    .article__image :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>

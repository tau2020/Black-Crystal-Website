# Copy to .env (never commit .env). All values are read on the server at runtime.

# Canonical public origin used for canonical URLs, sitemap and Open Graph (build time).
SITE_URL=https://blackcrystal.co.zw

# ── Contact form delivery (SMTP) ────────────────────────────────────────────────
# Leave unset to keep the form in its honest "not configured" state: submissions are
# rejected with HTTP 503 and visitors are shown direct email/phone alternatives.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); "false" uses STARTTLS when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Mailbox that receives enquiries (must be confirmed by Black Crystal before launch).
CONTACT_TO=
# Sender address the SMTP account is authorised to send as.
CONTACT_FROM=

# Optional: "capture" writes enquiries to .data/outbox instead of sending (local testing only;
# refused when NODE_ENV=production unless CONTACT_ALLOW_CAPTURE=true is also set).
CONTACT_TRANSPORT=
CONTACT_ALLOW_CAPTURE=

# Rate limiting (per client IP): max submissions per window.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=10
# Set to "true" only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ── Local review server (server/serve.mjs) ──────────────────────────────────────
HOST=127.0.0.1
PORT=4321

# Extra hostnames Astro may trust from Host/X-Forwarded-Host (comma-separated), e.g. a staging domain.
ALLOWED_HOSTS=
